# Optional: `docker compose up` works without a .env file.
# To override the defaults, copy this file to .env in the repository root.

# Local development password only. It goes into a connection URL, so use letters and digits.
# Postgres applies it only when the data volume is first created.
POSTGRES_PASSWORD=plp_dev_password

# Change these if a port is already taken on your machine.
WEB_PORT=3000
API_PORT=4000
MODEL_PORT=8000
POSTGRES_PORT=5432
